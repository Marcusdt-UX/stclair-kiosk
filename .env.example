# Copy this file to .env and fill in your keys.
# These are read ONLY by proxy-server.js. Do not rename them to VITE_* —
# Vite publishes any VITE_* variable the frontend references.

# Get your free key at https://aisstream.io
AISSTREAM_API_KEY=your_aisstream_key_here

# Get your free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# Where vessel-cache.json and coverage-log.jsonl are kept (optional).
# On Railway, attach a volume and this is picked up automatically from
# RAILWAY_VOLUME_MOUNT_PATH.
# DATA_DIR=./data

# Dev proxy URL override (optional, frontend)
# In dev mode, defaults to http://localhost:2610 automatically.
# In production build, defaults to same-origin (empty).
# VITE_PROXY_URL=http://localhost:2610
